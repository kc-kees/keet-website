generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// 1. Rollen definitie
enum Role {
  USER
  ADMIN
}

// 2. Status als Enum
enum Status {
  AANKOMEND
  GEWEEST
}

// 3. User model: Puur en alleen voor wie mag inloggen
model User {
  id    String @id @default(uuid())
  email String @unique
  rol   Role   @default(USER)

  // Magic Link velden
  loginToken     String?   @unique
  tokenExpiresAt DateTime?
}

model Uitje {
  id           String   @id @default(uuid())
  slug         String   @unique
  titel        String
  locatie      String
  datum        String
  beschrijving String?
  coverFoto    String?
  status       Status   @default(AANKOMEND)
  aangemaaktOp DateTime @default(now())

  // DE RELATIE: Eén uitje heeft een lijst (array) van meerdere foto's
  fotos AlbumFoto[]
}

// DE TABEL: Hier komen de URL's van je geüploade foto's in
model AlbumFoto {
  id           String   @id @default(uuid())
  url          String
  toegevoegdOp DateTime @default(now())

  // DE KOPPELING: We slaan het ID van het bijbehorende uitje op
  uitjeId String
  uitje   Uitje  @relation(fields: [uitjeId], references: [id], onDelete: Cascade)
}

// NIEUW & SCHOON: Eén centrale tabel voor iedereen op het leaderboard
model Speler {
  id          String @id @default(uuid())
  naam        String @unique // Bijv. "Kaylan", "Sjoerd", etc.
  bussenCount Int    @default(0)
}
